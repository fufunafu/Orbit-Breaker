[configuration]

entry_symbol = "godot_apple_plugins_game_center_start"
compatibility_minimum = 4.2

[libraries]
ios = "res://addons/GodotApplePluginsGameCenter/bin/GodotApplePluginsGameCenter.xcframework"
macos.arm64 = "res://addons/GodotApplePluginsGameCenter/bin/GodotApplePluginsGameCenter.framework"

[dependencies]
ios = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.xcframework": "" }
macos.arm64 = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.framework": "" }
